# Salin jadi .env lalu isi nilainya.

# Wajib untuk `bun run aqi` (ambil AQI dari stasiun WAQI/aqicn.org).
WAQI_TOKEN=

# Opsional
# WAQI_STASIUN=yogyakarta    # nama stasiun WAQI (default: yogyakarta -> Sleman, BMKG)
# AQI_REFRESH=on             # segarkan AQI otomatis saat server start (butuh WAQI_TOKEN); off untuk mematikan
# DASHBOARD_TOKEN=           # kalau di-set, /api/dashboard wajib Authorization: Bearer <token>
# RATE_LIMIT_PER_MIN=30      # batas POST /api/lapor per IP per menit
# CORS_ORIGIN=http://localhost:5173
# PORT=3000
